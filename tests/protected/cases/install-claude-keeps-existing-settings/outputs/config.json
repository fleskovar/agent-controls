{
  "permissions": {
    "allow": [
      "Bash(make test)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write ."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m agent_actions run runner.py --harness claude --hook pre-tool",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m agent_actions run runner.py --harness claude --hook stop",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
